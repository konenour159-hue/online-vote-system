# Certaines dépendances déclarent des « peer dependencies » incompatibles entre elles ; sans cette ligne,
# `npm install` (Vercel, Render, Docker) échoue.
legacy-peer-deps=true

# Render, Railway, etc. fixent NODE_ENV=production, et `npm install` ignore alors les devDependencies (prisma,
# typescript, @types/*) dont le build a besoin. Cette ligne les installe quand même.
include=dev
