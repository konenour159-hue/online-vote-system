# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Online Voting System
VITE_APP_VERSION=1.0.0

# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/voting_system

# JWT Secrets
JWT_ACCESS_SECRET=your_access_token_secret_key_min_32_characters
JWT_REFRESH_SECRET=your_refresh_token_secret_key_min_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@votingsystem.com
SMTP_FROM_NAME=Online Voting System

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Cors
CORS_ORIGIN=http://localhost:5173

# Redis (Optional for caching)
REDIS_URL=redis://localhost:6379

# Socket.IO
SOCKET_IO_CORS=http://localhost:5173

# --- Production (Render) ---
# Nombre de proxys devant l'API : Vercel puis Render = 2. Sans cela, tous les visiteurs partagent une seule adresse IP.
TRUST_PROXY=2
# Essais de connexion / inscription par adresse IP et par fenêtre (RATE_LIMIT_WINDOW minutes)
AUTH_RATE_LIMIT_MAX_REQUESTS=30
# Limite générale par adresse IP (large : un même groupe partage souvent la même connexion)
RATE_LIMIT_MAX_REQUESTS=1500

# Création du premier SUPER_ADMIN : npm run admin:create --workspace=backend (après npm run build)
# ADMIN_EMAIL=admin@votre-domaine.fr
# ADMIN_PASSWORD=<mot de passe fort : 8+ caractères, majuscule, minuscule, chiffre, symbole>
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=Genies

# Frontend (Vercel) : NE PAS définir VITE_API_URL en production. Le site appelle /api sur sa propre adresse,
# et vercel.json redirige vers l'API Render. Le définir casserait la politique de sécurité (CSP) du site.
